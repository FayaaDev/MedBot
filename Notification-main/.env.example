# SEHA portal credentials
SEHA_ID=your_national_id
SEHA_PW=your_password

# OTP API (https://github.com/ahalshehri/otp-api or your own endpoint)
N8N_OTP_URL=https://your-otp-server/otp
N8N_OTP_API_KEY=your_api_key

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_admin_chat_id

# Optional
N8N_OTP_METHOD=GET
N8N_OTP_TIMEOUT_MS=60000
N8N_OTP_MAX_AGE_SECONDS=120
N8N_OTP_DEBUG=false
SEHA_MAX_EXPORT_ATTEMPTS=5
